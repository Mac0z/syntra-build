#!/usr/bin/env bash
# Installed root-owned (0755). This is intentionally not a general command wrapper.
set -euo pipefail

workspace_root=/var/lib/syntra-build/workspaces
repository_root=/var/lib/syntra-build/repositories
worker=syntra-codex
control_plane=syntra-build
runtime_check=/usr/local/libexec/check-codex-runtime
acl_helper=/usr/local/libexec/syntra-codex-acl.py

validate_workspace() {
  local candidate project milestone
  candidate=$(realpath -e -- "$1")
  case "$candidate" in
    "$workspace_root"/*/*) ;;
    *) echo "workspace is outside the managed root" >&2; exit 65 ;;
  esac
  project=${candidate#"$workspace_root"/}
  project=${project%%/*}
  milestone=${candidate##*/}
  [[ $project =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ \
    && $milestone =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ \
    && $candidate == "$workspace_root/$project/$milestone" \
    && -e $candidate/.git ]] || {
    echo "workspace is not an exact managed M19 path" >&2
    exit 65
  }
  printf '%s\n' "$candidate"
}

remove_worker_acl() {
  local candidate=$1 project=${1#"$workspace_root"/}
  local rc=0
  project=${project%%/*}
  /usr/bin/python3 -I "$acl_helper" revoke "$candidate" || rc=70
  if [[ -d $repository_root/$project/repo.git ]]; then
    setfacl -P -R -x "u:$worker" "$repository_root/$project/repo.git" 2>/dev/null || rc=70
  fi
  setfacl -x "u:$worker" "$workspace_root/$project" \
    "$repository_root/$project" 2>/dev/null || rc=70
  return "$rc"
}

repair_control_plane_handoff() {
  /usr/bin/python3 -I "$acl_helper" handoff "$1"
}

finish() {
  local rc=$? handoff_rc=0 cleanup_rc=0
  trap - EXIT
  set +e
  repair_control_plane_handoff "$workspace" || handoff_rc=70
  # Revoke even when repair fails. The parent traversal grant is removed last.
  remove_worker_acl "$workspace" || cleanup_rc=70
  if [[ $handoff_rc -ne 0 || $cleanup_rc -ne 0 ]]; then
    echo "trusted filesystem handoff or isolation cleanup failed" >&2
    exit 70
  fi
  exit "$rc"
}

if [[ $# -eq 2 && $1 == --check-runtime ]]; then
  exec "$runtime_check" "$2"
fi

if [[ $# -eq 2 && ( $1 == --cleanup || $1 == --repair-handoff ) ]]; then
  workspace=$(validate_workspace "$2")
  exec 9>/run/lock/syntra-codex.lock
  flock 9
  trap finish EXIT
  exit 0
fi

if [[ $# -ne 4 || $3 != exec || $4 != - ]]; then
  echo "usage: syntra-codex-launch <managed-worktree> <approved-codex> exec -" >&2
  exit 64
fi
workspace=$(validate_workspace "$1")
case "$2" in
  /usr/bin/codex|/usr/local/bin/codex) executable=$2 ;;
  *) echo "executable is not an approved Codex CLI path" >&2; exit 65 ;;
esac
[[ -x $executable ]] || {
  echo "Codex executable is unavailable" >&2
  exit 66
}

"$runtime_check" "$executable"

project=${workspace#"$workspace_root"/}
project=${project%%/*}
repository="$repository_root/$project/repo.git"
[[ -d $repository ]] || { echo "managed repository is unavailable" >&2; exit 66; }
worker_home=$(getent passwd "$worker" | cut -d: -f6)
[[ -n $worker_home && -d $worker_home ]] || { echo "worker home is unavailable" >&2; exit 66; }

# One shared Unix identity cannot isolate two simultaneous ACL grants. Serialize
# at this privilege boundary, reconcile stale access left by interruption, then
# grant only this persisted workspace and its project-specific Git metadata.
exec 9>/run/lock/syntra-codex.lock
flock 9
trap finish EXIT
# Close every project traversal grant, including orphaned repositories whose
# worktree was removed. No worker may inherit another project's stale access.
find -P "$workspace_root" "$repository_root" -mindepth 1 -maxdepth 1 -type d \
  -exec setfacl -x "u:$worker" {} +
# Repair interrupted work before removing stale grants; valuable output must
# survive normal cleanup. No new worker is started if any handoff fails.
stale_workspaces=$(find -P "$workspace_root" -mindepth 2 -maxdepth 2 -type d -print)
while IFS= read -r stale; do
  [[ -n $stale ]] || continue
  workspace=$(validate_workspace "$stale")
  trap finish EXIT
  repair_control_plane_handoff "$workspace"
  remove_worker_acl "$workspace"
  trap - EXIT
done <<< "$stale_workspaces"
workspace=$(validate_workspace "$1")
trap finish EXIT
find -P "$repository_root" -mindepth 2 -maxdepth 2 -type d \
  -exec setfacl -P -R -x "u:$worker" {} +
setfacl -m "u:$worker:x" /var/lib/syntra-build "$workspace_root" \
  "$workspace_root/$project" "$repository_root" "$repository_root/$project"
/usr/bin/python3 -I "$acl_helper" grant "$workspace"
setfacl -P -Rm "u:$worker:rX" "$repository"

# Prove effective OS access under the same identity before invoking Codex.
# mktemp creates only one reversible probe in the granted worktree.
/usr/bin/setpriv --reuid="$worker" --regid="$worker" --init-groups --no-new-privs \
  /usr/bin/env -i PATH=/usr/bin:/bin \
  /usr/local/libexec/check-codex-workspace "$workspace" "$repository"

cd -- "$workspace"
/usr/bin/prlimit --nproc=128 --nofile=1024 --fsize=104857600 \
  /usr/bin/setpriv --reuid="$worker" --regid="$worker" --init-groups --no-new-privs \
  /usr/bin/env -i HOME="$worker_home" USER="$worker" LOGNAME="$worker" \
  XDG_CONFIG_HOME="$worker_home/.config" PATH=/usr/local/bin:/usr/bin:/bin \
  LANG=C.UTF-8 LC_ALL=C.UTF-8 TMPDIR=/tmp \
  GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 "$executable" exec \
  --ignore-user-config --sandbox workspace-write -c 'approval_policy="never"' \
  --enable code_mode --enable code_mode_only --enable code_mode_host \
  - <&0 &
child=$!
stop_child() {
  trap '' TERM INT HUP
  kill -TERM "$child" 2>/dev/null || true
  wait "$child" 2>/dev/null || true
  exit 143
}
trap stop_child TERM INT HUP
wait "$child"
