[Unit]
Description=Syntra Build control plane
After=network-online.target

[Service]
Type=simple
User=syntra-build
Group=syntra-build
ExecStart=/opt/syntra-build/venv/bin/python -m syntra_build.service --config /etc/syntra-build/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
# Deliberately omitted: the trusted service may invoke exactly one sudoers-
# constrained identity-transition helper. The worker itself uses no_new_privs.
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
